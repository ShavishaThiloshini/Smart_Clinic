# Copy this to .env.production on the production server. Never commit the copy.
DB_NAME=smart_clinic
DB_USER=smart_clinic
DB_PASSWORD=replace-with-a-long-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
APP_PORT=80

# Leave empty when users access the API only through this same host.
CORS_ORIGIN=
